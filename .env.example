# Copy to .env.local at the project root. Use only a publishable (or legacy anon) key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only deployment guard. Use the project ref from the staging URL.
PAYLINK_STAGING_PROJECT_REF=
# Legacy fallback, if your project has no publishable key:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Never put a secret or service_role key in a NEXT_PUBLIC_ variable.
